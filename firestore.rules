rules_version = '2';
service cloudfirebase.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Standard high-security global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerifiedUser() {
      return isSignedIn() && (request.auth.token.email_verified == true || request.auth.token.firebase.sign_in_provider == 'google.com');
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Bootstrapped admin check using user email from runtime
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'contact@360degresfrance.org';
    }

    // Helper functions for entity structure validation
    function isValidPatient(data) {
      return data.keys().hasAll(['uid', 'email'])
        && data.uid is string && data.uid.size() <= 128
        && data.email is string && data.email.size() <= 256
        && (!data.keys().hasAny(['displayName']) || (data.displayName is string && data.displayName.size() <= 100));
    }

    function isValidNote(data) {
      return data.keys().hasAll(['id', 'title', 'content', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.title is string && data.title.size() <= 128
        && data.content is string && data.content.size() <= 5000
        && (!data.keys().hasAny(['treatmentId']) || (data.treatmentId is string && data.treatmentId.size() <= 128));
    }

    function isValidActivityLog(data) {
      return data.keys().hasAll(['id', 'actionType', 'description', 'timestamp'])
        && data.id is string && data.id.size() <= 128
        && data.actionType is string && data.actionType.size() <= 64
        && data.description is string && data.description.size() <= 256;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'name', 'rating', 'text', 'service', 'date', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.name is string && data.name.size() <= 150
        && (data.rating is number || data.rating is int) && data.rating >= 1 && data.rating <= 5
        && data.text is string && data.text.size() <= 3000
        && data.service is string && data.service.size() <= 200
        && data.date is string && data.date.size() <= 100
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    // Match rules for public reviews
    match /reviews/{reviewId} {
      allow read, list: if true;
      allow create: if isValidId(reviewId) && isValidReview(request.resource.data);
      allow update, delete: if isAdmin();
    }

    // Match rules for Patients profiles
    match /patients/{patientId} {
      allow get: if isOwner(patientId) || isAdmin();
      allow create: if isOwner(patientId) && isValidPatient(request.resource.data);
      allow update: if (isOwner(patientId) && isValidPatient(request.resource.data)) || isAdmin();
      allow delete: if isAdmin();

      // Subcollection for Patient Notes
      match /notes/{noteId} {
        allow list, get: if isOwner(patientId) || isAdmin();
        allow create: if isOwner(patientId) && isValidNote(request.resource.data);
        allow update: if (isOwner(patientId) && isValidNote(request.resource.data) 
          && request.resource.data.createdAt == resource.data.createdAt) || isAdmin();
        allow delete: if isOwner(patientId) || isAdmin();
      }

      // Subcollection for Patient Workspace Activity Logs
      match /activity_logs/{logId} {
        allow list, get: if isOwner(patientId) || isAdmin();
        allow create: if isOwner(patientId) && isValidActivityLog(request.resource.data);
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
  }
}
